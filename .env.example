# --- Banco ---
POSTGRES_USER=trainup
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=trainup

# --- Aplicação ---
# development: gera chave temporária se SECRET_KEY estiver vazia.
# production: a API NÃO inicia sem SECRET_KEY (mínimo 32 caracteres).
APP_ENV=production
# gere com: openssl rand -hex 32
SECRET_KEY=
# Código exigido no cadastro de novos Personal Trainers (vazio = cadastro público de personal desabilitado)
PERSONAL_SIGNUP_CODE=troque-este-codigo
# Em produção real, deixe false (cria contas de demonstração com senha conhecida quando true)
SEED_DEMO=true
# Swagger em http://localhost/api/docs
ENABLE_DOCS=true
